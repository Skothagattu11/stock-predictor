# Copy to .env and fill in. Leave FINNHUB_API_KEY empty to run in simulated mode.
# Get a free key at https://finnhub.io/register
FINNHUB_API_KEY=
# Google Gemini API key for the in-app AI assistant (get one at aistudio.google.com).
# Leave empty to disable the assistant.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-2.5-flash).
GEMINI_MODEL=
# Optional AI-assistant abuse limits (token-cost protection). Defaults shown.
CHAT_PER_MIN=8              # max chat requests per IP per minute
CHAT_PER_DAY_IP=80         # max chat requests per IP per day
CHAT_PER_DAY=800           # max chat requests across all users per day
CHAT_MAX_OUTPUT_TOKENS=700 # cap on Gemini response length
PORT=3000

# ── Wealth Manager (Supabase) ─────────────────────────────────────────────────
# Run supabase-migration.sql in Supabase SQL Editor, then copy these values
# from your Supabase project Settings → API.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=      # service_role key (server-only, never expose in browser)
SUPABASE_ANON_KEY=              # anon/publishable key
APP_URL=http://localhost:3000   # Base URL used in public share links
